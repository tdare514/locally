{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "electron/dist",
    "rootDir": "electron",
    "types": ["node"]
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["electron/dist"]
}
