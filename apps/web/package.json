{
  "name": "spotify-local-import",
  "version": "0.1.0",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "check": "next typegen && tsc --noEmit && eslint && vitest run",
    "desktop:build": "LOCALLY_DESKTOP_BUILD=1 next build && node scripts/prepare-standalone.mjs && tsc -p tsconfig.electron.json",
    "desktop": "electron electron/dist/main.js",
    "desktop:dev": "tsc -p tsconfig.electron.json && LOCALLY_DESKTOP_URL=http://127.0.0.1:3000 electron electron/dist/main.js",
    "desktop:ffmpeg": "bash scripts/build-ffmpeg.sh",
    "desktop:package": "node scripts/check-ffmpeg.mjs && npm run desktop:build && electron-builder --mac --dir"
  },
  "dependencies": {
    "music-metadata": "^11.16.1",
    "next": "16.3.6",
    "node-id3": "^0.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
