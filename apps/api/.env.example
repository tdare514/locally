# Copy to .env.local for local overrides. Every variable below has a
# dev-friendly default in code (see src/server/config/env.ts), so
# `npm install && npm run dev` works with none of these set at all.

# --- Database (Drizzle ORM over libSQL) ---
# Local dev/default: a SQLite file at apps/api/data/dev.db.
# Production: a Turso (libSQL) URL, e.g. libsql://<db>-<org>.turso.io?authToken=...
DATABASE_URL=file:./data/dev.db

# --- Secrets used to hash sign-in codes and device tokens ---
# REQUIRED in production: with NODE_ENV=production, the server refuses to
# start if either is unset (see src/server/config/env.ts), rather than
# falling back to an insecure default. Any long random string; rotating
# either one signs out every device / invalidates every outstanding code.
# Dev default (INSECURE, logged loudly at startup if unset): a fixed string.
AUTH_PEPPER=
TOKEN_PEPPER=

# --- File storage ---
# "local" (default): a folder on disk under apps/api/data/files, served by
#   this app's own /v1/internal/local-upload|local-download routes with
#   HMAC-signed URLs (derived from TOKEN_PEPPER).
# "blob": Vercel Blob, private store. Requires BLOB_READ_WRITE_TOKEN — the
#   server refuses to start with FILE_STORE=blob and no token set, rather
#   than silently falling back to local storage.
FILE_STORE=local
BLOB_READ_WRITE_TOKEN=

# --- Mail (the six-digit sign-in code) ---
# "console" (default): the code is printed to the server log — read it there
#   in local dev instead of receiving an email.
# "resend": sends through Resend. Requires RESEND_API_KEY and MAIL_FROM — the
#   server refuses to start with MAILER=resend and no key set, rather than
#   silently falling back to printing codes to the log.
MAILER=console
RESEND_API_KEY=
MAIL_FROM=Locally Sync <sync@example.com>

# --- Cron (see vercel.ts: a daily job hits /v1/internal/cleanup) ---
# REQUIRED in production: with NODE_ENV=production, the server refuses to
# start if this is unset, so the cleanup route can't be triggered by anyone.
# Left unset in dev on purpose so a local curl can exercise it directly.
CRON_SECRET=

# --- CORS ---
# Comma-separated list of allowed browser origins for the Mac web app.
# Entries ending in ":*" match any port. Default covers local dev; set this
# to your production web app's origin(s) when deploying. The iOS app is not
# a browser and is unaffected either way.
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# --- Public base URL ---
# Used to build absolute local-storage URLs (FILE_STORE=local only). Default
# is fine for the Mac app talking to itself; set this to the Mac's LAN
# address (e.g. http://192.168.1.23:4000) so the iOS app on the same Wi-Fi
# can reach signed upload/download URLs during development. See README.md.
PUBLIC_BASE_URL=http://localhost:4000
